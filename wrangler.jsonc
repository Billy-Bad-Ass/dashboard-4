/**
 * Cloudflare Workers configuration for the BBA Network heartbeat dashboard.
 *
 * Everything here is sized for the $5/month Workers Paid plan, which is what
 * makes this dashboard possible at all:
 *
 *  - D1        — the whole business database (projects, spend, clients, deals,
 *                agent runs, metric history). 5 GB included; this uses megabytes.
 *  - KV        — the hot cache in front of Stripe/GitHub/Calendar so a page load
 *                never waits on three third-party APIs.
 *  - Cron      — the heartbeat itself. Free plan caps you at a handful of
 *                triggers; Paid is what lets this poll every 10 minutes.
 *  - R2        — exports and report archives. Egress is free, which is the
 *                entire reason to use it over S3.
 *
 * Secrets are NOT set here. Use `wrangler secret put <NAME>` — see docs/RUNBOOK.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bba-heartbeat",

  // Points at the wrapper, NOT at .open-next/worker.js. The generated worker
  // has no `scheduled` handler, so with `main` aimed straight at it the cron
  // triggers below fire into nothing. See worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Without this, `wrangler deploy` silently wipes plain-text vars that were
  // added in the Cloudflare dashboard but are absent from this file.
  "keep_vars": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bba-heartbeat",
      // Replace with the id printed by `wrangler d1 create bba-heartbeat`.
      "database_id": "a57d42d4-701d-4a24-8143-3271c0d4de86",
      "migrations_dir": "db/migrations"
    },
    {
      // BBA Production's enquiry database, read-only in practice: this
      // dashboard counts what the form took, it never writes to it. No
      // migrations_dir — that schema is owned and applied by the
      // bba-production-form Worker's own deploy, in the Code repository, and
      // pointing a second migration runner at it is how two deploys start
      // fighting over one table.
      "binding": "PRODUCTION_DB",
      "database_name": "bba-production",
      "database_id": "b6322b47-8b5e-43e3-a68f-9267c0fafea5"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Replace with the id printed by `wrangler kv namespace create CACHE`.
      "id": "2810c7dcd0ac438aaa641f5aacee5058"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "bba-heartbeat-archive"
    }
  ],

  // The heartbeat. Each tick fans out to the pollers in lib/heartbeat.ts.
  // Off-the-hour on purpose: cron jobs at :00 queue behind everyone else's.
  "triggers": {
    "crons": [
      "*/10 * * * *", // fast pulse — Stripe, GitHub, deploy state
      "17 * * * *",   // hourly — calendar refresh, metric snapshot
      "23 6 * * *"    // daily 06:23 UTC — roll up yesterday, prune history
    ]
  },

  "vars": {
    // Public, non-secret values only. Anything sensitive goes in `wrangler secret put`.
    // Update this when a custom domain is attached (see docs/DOMAINS.md).
    // Attaching the domain itself is done in the Cloudflare dashboard, NOT with a
    // `routes` entry here: a route makes the deploy responsible for creating DNS
    // records, which the deploy token has no permission to do.
    "NEXT_PUBLIC_SITE_URL": "https://heartbeat.bbanetwork.org",
    "GITHUB_OWNER": "Billy-Bad-Ass",
    "CALENDAR_ACCOUNT": "bbacentralworkspace@gmail.com"
  }
}
