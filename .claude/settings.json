{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run check)",
      "Bash(npm run icons:build)",
      "Bash(npm run workflows:check)",
      "Bash(node scripts/*.mjs)",
