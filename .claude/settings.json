      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git grep:*)",
      "Read(//home/user/Project-4/**)",
      "Edit(//home/user/Project-4/app/**)",
      "Edit(//home/user/Project-4/lib/**)",
      "Edit(//home/user/Project-4/config/**)",
      "Edit(//home/user/Project-4/docs/**)",
      "WebSearch",
      "WebFetch",
      "mcp__stripe__stripe_api_read",
      "mcp__stripe__stripe_api_search",
      "mcp__stripe__stripe_analytics",
      "mcp__stripe__search_stripe_documentation"
